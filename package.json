{
  "name": "@boardgamers/puerto-rico",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "description": "Puerto Rico 1897 Special Edition for Boardgamers Space",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test:browser": "node test/browser.mjs && node test/locales-browser.mjs && node test/cargo-browser.mjs",
    "publish:bgs": "pnpm build && node scripts/publish-release.mjs",
    "publish:metadata": "node scripts/publish-metadata.mjs",
    "test:tutorials": "node test/tutorial-browser.mjs",
    "release:gallery": "pnpm build && node scripts/release-gallery.mjs",
    "publish:gallery": "node scripts/publish-gallery.mjs"
  },
  "dependencies": {
    "@boardgamers/protocol": "file:vendor/boardgamers-protocol-0.11.0.tgz",
    "@noble/hashes": "2.0.1",
    "morphdom": "2.7.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.6.2"
  }
}
